# Declared here so the "Deploy to Cloudflare" wizard prompts for each value
# during deploy and stores it as an encrypted Worker secret. This file holds
# names only — never put real values in it. For local dev, copy to .dev.vars
# (gitignored) and fill in.
TELEGRAM_BOT_TOKEN=        # paste from @BotFather
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=  # optional; your numeric user id. Required for group chats — otherwise any member can command the bot via buttons. Defaults to TELEGRAM_CHAT_ID (a 1:1 DM)
TELEGRAM_WEBHOOK_SECRET=   # random string; pass same value to setWebhook secret_token
GITHUB_REPO=owner/your-aeon-fork
GITHUB_TOKEN=
# Optional OpenTelemetry (opt-in; leave blank to disable). Point at a Langfuse
# OTLP endpoint (https://<host>/api/public/otel) or any OTLP collector.
OTEL_EXPORTER_OTLP_ENDPOINT=   # base URL; /v1/traces is appended automatically
OTEL_EXPORTER_OTLP_HEADERS=    # comma-separated k=v, e.g. Authorization=Basic <b64>
OTEL_SERVICE_NAME=             # optional; defaults to aeon-webhook
