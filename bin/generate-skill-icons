#!/usr/bin/env node
// generate-skill-icons — build the per-skill icon assets from catalog/skill-icons.json
//
// Usage:
//   bin/generate-skill-icons            Regenerate all icon assets
//   bin/generate-skill-icons --check    Verify assets are up to date (CI), exit 1 on drift
//
// Reads the canonical glyph map (catalog/skill-icons.json) plus the category of
// each skill (catalog/skills.json) and writes:
//   • docs/assets/skill-icons/<slug>.svg   — standalone, category-tinted SVGs the
//     README and docs reference via <img> (GitHub strips inline <svg>, so the
//     markdown surfaces need real files with an explicit colour baked in).
//   • apps/dashboard/lib/skill-icons.data.ts — the raw glyph map bundled into the
//     dashboard client, rendered with currentColor so it inherits UI colour.
//
// The website (aeon-website) keeps its own mirror of the map at
// app/skill-icons.data.ts — update it when the glyphs here change.

const fs = require('fs')
const path = require('path')

const ROOT = path.resolve(__dirname, '..')
const ICONS_JSON = path.join(ROOT, 'catalog', 'skill-icons.json')
const SKILLS_JSON = path.join(ROOT, 'catalog', 'skills.json')
const SVG_DIR = path.join(ROOT, 'docs', 'assets', 'skill-icons')
const DATA_TS = path.join(ROOT, 'apps', 'dashboard', 'lib', 'skill-icons.data.ts')

const CHECK = process.argv.includes('--check')

// Category → stroke colour, mirroring CATEGORIES in apps/dashboard/lib/constants.ts.
const CATEGORY_COLOR = {
  core: '#E5484D',
  evolution: '#A855F7',
  basics: '#30A46C',
  dev: '#3B82F6',
  crypto: '#FF6B1A',
  productivity: '#06B6D4',
}
const FALLBACK_COLOR = '#8B8B8B' // any skill not yet in a first-party pack

// Shared render attributes — the wrapper every glyph is dropped into. The glyph
// markup itself is stroke-only unless it overrides fill/stroke inline.
const SW = '1.8'

function loadJson(p) {
  return JSON.parse(fs.readFileSync(p, 'utf8'))
}

function standaloneSvg(inner, color) {
  // Explicit stroke + color so the file renders identically outside any CSS
  // context (an <img> tag). `color` is what inline `fill='currentColor'` marks
  // (Base, X, dots) resolve to.
  return (
    `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' width='24' height='24' ` +
    `fill='none' stroke='${color}' color='${color}' ` +
    `stroke-width='${SW}' stroke-linecap='round' stroke-linejoin='round'>${inner}</svg>\n`
  )
}

function dataTs(icons) {
  const entries = Object.keys(icons)
    .sort()
    .map((slug) => `  ${JSON.stringify(slug)}: ${JSON.stringify(icons[slug])},`)
    .join('\n')
  return (
    `// GENERATED by bin/generate-skill-icons — do not edit by hand.\n` +
    `// Source of truth: catalog/skill-icons.json. Run bin/generate-skill-icons to refresh.\n` +
    `//\n` +
    `// Each value is the inner SVG markup for one skill's glyph, rendered inside a\n` +
    `// <svg viewBox='0 0 24 24'> with currentColor stroke (see components/ui/SkillGlyph).\n` +
    `export const SKILL_ICONS: Record<string, string> = {\n${entries}\n}\n`
  )
}

function main() {
  const { icons } = loadJson(ICONS_JSON)
  const skills = loadJson(SKILLS_JSON).skills || []
  const categoryBySlug = Object.fromEntries(skills.map((s) => [s.slug, s.category]))

  // Coverage: every catalog skill must have a glyph.
  const missing = skills.map((s) => s.slug).filter((slug) => !icons[slug])
  if (missing.length) {
    console.error(`generate-skill-icons: missing glyphs for ${missing.length} skill(s): ${missing.join(', ')}`)
    console.error('Add them to catalog/skill-icons.json.')
    process.exit(1)
  }
  const orphans = Object.keys(icons).filter((slug) => !categoryBySlug[slug])
  for (const slug of orphans) {
    console.warn(`generate-skill-icons: WARN glyph "${slug}" has no catalog entry — tinted with the fallback colour`)
  }

  // Plan the writes.
  const files = new Map()
  for (const [slug, inner] of Object.entries(icons)) {
    const color = CATEGORY_COLOR[categoryBySlug[slug]] || FALLBACK_COLOR
    files.set(path.join(SVG_DIR, `${slug}.svg`), standaloneSvg(inner, color))
  }
  files.set(DATA_TS, dataTs(icons))

  if (CHECK) {
    let drift = 0
    for (const [p, content] of files) {
      const cur = fs.existsSync(p) ? fs.readFileSync(p, 'utf8') : null
      if (cur !== content) {
        drift++
        console.error(`generate-skill-icons: DRIFT ${path.relative(ROOT, p)}`)
      }
    }
    // Flag any stale SVGs for skills that no longer exist.
    if (fs.existsSync(SVG_DIR)) {
      const want = new Set([...files.keys()].map((p) => path.basename(p)))
      for (const f of fs.readdirSync(SVG_DIR)) {
        if (f.endsWith('.svg') && !want.has(f)) {
          drift++
          console.error(`generate-skill-icons: STALE docs/assets/skill-icons/${f}`)
        }
      }
    }
    if (drift) {
      console.error(`\ngenerate-skill-icons: ${drift} file(s) out of date — run bin/generate-skill-icons`)
      process.exit(1)
    }
    console.log(`generate-skill-icons: OK — ${icons ? Object.keys(icons).length : 0} glyph(s) up to date`)
    return
  }

  fs.mkdirSync(SVG_DIR, { recursive: true })
  // Drop stale SVGs (renamed/removed skills) so the dir mirrors the catalog.
  const want = new Set([...files.keys()].filter((p) => p.endsWith('.svg')).map((p) => path.basename(p)))
  for (const f of fs.readdirSync(SVG_DIR)) {
    if (f.endsWith('.svg') && !want.has(f)) fs.rmSync(path.join(SVG_DIR, f))
  }
  for (const [p, content] of files) {
    fs.mkdirSync(path.dirname(p), { recursive: true })
    fs.writeFileSync(p, content)
  }
  console.log(`generate-skill-icons: wrote ${want.size} SVG(s) + ${path.relative(ROOT, DATA_TS)}`)
}

main()
